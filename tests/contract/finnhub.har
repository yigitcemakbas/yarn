      "text": "[{\"category\":\"merger\",\"datetime\":1792395694,\"headline\":\"Red Cat proposes to acquire engine specialist Steyr Motors\",\"id\":8642469,\"image\":\"https://res.cloudinary.com/whirlpooldata/image/upload/v1567050932/sa_jgen9y.png\",\"related\":\"\",\"source\":\"SeekingAlpha\",\"summary\":\"\",\"url\":\"https://seekingalpha.com/news/4654104-red-cat-proposes-to-acquire-engine-specialist-steyr-motors?utm_source=feed_news_m_a\\u0026utm_medium=referral\\u0026feed_item_type=news\"},{\"category\":\"merger\",\"datetime\":1792391104,\"headline\":\"Starboard sees growth potential in Skyworks after Qorvo deal - report\",\"id\":8642266,\"image\":\"https://res.cloudinary.com/whirlpooldata/image/upload/v1567050932/sa_jgen9y.png\",\"related\":\"\",\"source\":\"SeekingAlpha\",\"summary\":\"\",\"url\":\"https://seekingalpha.com/news/4654092-starboard-sees-growth-potential-in-skyworks-after-qorvo-deal---report?utm_source=feed_news_m_a\\u0026utm_medium=referral\\u0026feed_item_type=news\"},{\"category\":\"merger\",\"datetime\":1792368000,\"headline\":\"OpenWorld (NASDAQ: OPNW) Signs Definitive Merger Agreement to Acquire Blocksight as the Agentic Foundation for Its Up to $1 Billion Tokenized Solar and AI Computing Program with Meridian and Up to $130 Million IP-Backed Transaction with BeyondAI\",\"id\":8641126,\"image\":\"https://res.cloudinary.com/whirlpooldata/image/upload/v1567047386/bw_flnhy4.jpg\",\"related\":\"\",\"source\":\"BusinessWire\",\"summary\":\"LAKE MARY, Fla.--(BUSINESS WIRE)--OpenWorld, Inc. (“OpenWorld” or the “Company”) (NASDAQ: OPNW), an innovation company advancing global real-world asset (“RWA”) tokenization, today announced the signing of a definitive merger agreement to acquire Blocksight and outlined how its acquisition of Blocksight Holdings Co. (“Blocksight”), announced on October 1, 2026, is intended to serve as the operating foundation for the Company’s tokenized financing programs in infrastructure and energy. Blocksigh\",\"url\":\"http